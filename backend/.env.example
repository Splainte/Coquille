# Coquille — configuration backend (copier en .env, NON versionné)
#
#   cp .env.example .env   puis éditer les valeurs
#
# Le backend charge ce .env au démarrage (cf. config._load_dotenv). Une variable
# déjà définie dans l'environnement réel a priorité sur le fichier.

# --- Correction LLM (OpenRouter) ---
# Sans clé, la correction se limite au glossaire (déterministe). Avec clé, la
# passe LLM corrige casse/orthographe/jargon mal transcrit (timing-safe).
OPENROUTER_API_KEY=
# Modèle OpenRouter (défaut : anthropic/claude-sonnet-4.6).
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Forcer le mode hors-ligne (glossaire seul) même si une clé est présente : =1
COQUILLE_CORRECT_OFFLINE=

# --- Transcription Voxtral (API Mistral, moteur "voxtral") ---
MISTRAL_API_KEY=
